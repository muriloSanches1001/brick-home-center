{
  "name": "brick-home-center",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.11.0",
    "npm": ">=11.2.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"**/*.{css,scss,vue,html}\"",
    "typecheck": "vue-tsc --noEmit",
    "stylelint:fix": "stylelint \"**/*.{css,scss,vue,html}\" --fix",
    "ci:all": "npm run typecheck && npm run lint && npm run build && npm run test",
    "test": "vitest --run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@nuxt/fonts": "0.12.1",
    "@nuxt/icon": "2.1.0",
    "@nuxt/image": "2.0.0",
    "@nuxtjs/robots": "5.5.6",
    "@nuxtjs/sitemap": "7.4.7",
    "@pinia/nuxt": "0.11.3",
    "@vueuse/nuxt": "14.0.0",
    "nuxt": "4.2.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "3.1.0",
    "@nuxt/eslint": "1.11.0",
    "@nuxt/test-utils": "3.20.1",
    "@nuxtjs/stylelint-module": "5.2.1",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.22",
    "happy-dom": "20.0.10",
    "postcss": "8.5.6",
    "postcss-html": "1.8.0",
    "stylelint": "16.25.0",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-standard": "39.0.1",
    "stylelint-config-tailwindcss": "1.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.3"
  }
}
